<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.keygenqt.ydx</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <name>YDX</name>
  <summary>Edit collections, learn on any device!</summary>
  <description>
    <p>A powerful cross-platform application for creating and managing learning collections.</p>
    <p>Features:</p>
    <ul>
      <li>Native interface on all 8 platforms</li>
      <li>Lightning fast on any device</li>
      <li>Synchronization between all your devices</li>
      <li>Available in Russian, English, and Chinese on all platforms</li>
      <li>Simple and intuitive interface</li>
      <li>AI-powered content generation</li>
    </ul>
  </description>

  <developer id="com.keygenqt">
    <name>Vitaliy Zarubin</name>
  </developer>

  <url type="homepage">https://github.com/keygenqt/ydx</url>
  <url type="vcs-browser">https://github.com/keygenqt/ydx</url>
  <url type="bugtracker">https://github.com/keygenqt/ydx/issues</url>

  <translation type="gettext">com.keygenqt.ydx</translation>
  <launchable type="desktop-id">com.keygenqt.ydx.desktop</launchable>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2024-01-18">
      <description>
        <p>Initial release</p>
        <ul>
          <li>Basic collection management</li>
          <li>Cross-platform UI</li>
          <li>Device synchronization</li>
          <li>Multi-language support (EN, RU, ZH)</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
