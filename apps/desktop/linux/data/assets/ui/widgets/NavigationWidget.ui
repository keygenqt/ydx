<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="YdxNavigationWidget" parent="GtkBox">
		<child>
			<object class="AdwNavigationView"  id="IdNavigation">
				<property name="hexpand">True</property>
				<property name="vexpand">True</property>
				<child>
					<!-- First page for stack -->
					<object class="YdxWelcomePage"/>
				</child>
			</object>
		</child>
	</template>
</interface>
