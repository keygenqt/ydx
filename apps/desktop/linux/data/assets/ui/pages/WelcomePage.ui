<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="YdxWelcomePage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">YDX</property>
    <property name="can-pop">true</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" />
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="margin-start">20</property>
            <property name="margin-end">20</property>
            <property name="spacing">40</property>
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="label">
                <property name="label" translatable="yes">Welcome!</property>
                <style>
                  <class name="welcome-title" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="spacing">20</property>
                <property name="margin-bottom">16</property>
                <property name="orientation">horizontal</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkFrame">
                    <property name="width-request">150</property>
                    <property name="height-request">150</property>
                    <style>
                      <class name="CssAppIcon" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="IdAbout">
                <property name="label" translatable="yes">About</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
