<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="YdxWelcomeAuth" parent="GtkBox">
		<!-- Растягиваем корневой виджет на всю страницу -->
		<property name="hexpand">True</property>
		<property name="vexpand">True</property>
		<property name="halign">fill</property>
		<property name="valign">fill</property>
		
		<!-- Фон на всю страницу -->
		<style>
			<class name="navigation-bg" />
		</style>

		<!-- Центрирующий контейнер для контента -->
		<child>
			<object class="GtkBox">
				<property name="halign">center</property>
				<property name="valign">center</property>
				<property name="hexpand">True</property>  <!-- 👈 добавил -->
				<property name="vexpand">True</property>  <!-- 👈 добавил -->
				<property name="orientation">vertical</property>
				<property name="spacing">30</property>
				<property name="margin-start">20</property>
				<property name="margin-end">20</property>

				<child>
					<object class="GtkLabel" id="label">
						<property name="label" translatable="yes">Welcome to YDX!</property>
						<style>
							<class name="welcome-title" />
						</style>
					</object>
				</child>

				<child>
					<object class="GtkBox">
						<property name="spacing">20</property>
						<property name="orientation">horizontal</property>
						<property name="halign">center</property>
						<child>
							<object class="GtkFrame">
								<property name="width-request">120</property>
								<property name="height-request">120</property>
								<style>
									<class name="CssAppIcon" />
								</style>
							</object>
						</child>
					</object>
				</child>

				<child>
					<object class="GtkBox">
						<property name="orientation">vertical</property>
						<property name="spacing">8</property>
						<property name="halign">center</property>
						<child>
							<object class="GtkLabel">
								<property name="label" translatable="yes">✓ Native experience on all 8 platforms</property>
								<style>
									<class name="body" />
								</style>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label" translatable="yes">✓ Lightning fast on any device</property>
								<style>
									<class name="body" />
								</style>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label" translatable="yes">✓ Sync across all devices</property>
								<style>
									<class name="body" />
								</style>
							</object>
						</child>
					</object>
				</child>

				<child>
					<object class="GtkBox">
						<property name="spacing">20</property>
						<property name="orientation">horizontal</property>
						<property name="halign">center</property>
						<property name="margin-top">16</property>
						<property name="margin-bottom">16</property>
						<child>
							<object class="GtkButton" id="IdSignIn">
								<property name="halign">center</property>
								<property name="valign">center</property>
								<property name="child">
									<object class="GtkBox">
										<property name="spacing">8</property>
										<child>
											<object class="GtkImage">
												<property name="icon-name">avatar-default-symbolic</property>
												<property name="pixel-size">18</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label" translatable="yes">Sign In</property>
											</object>
										</child>
									</object>
								</property>
								<style>
									<class name="pill" />
									<class name="suggested-action" />
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton" id="IdSignUp">
								<property name="halign">center</property>
								<property name="valign">center</property>
								<property name="child">
									<object class="GtkBox">
										<property name="spacing">8</property>
										<child>
											<object class="GtkImage">
												<property name="icon-name">contact-new-symbolic</property>
												<property name="pixel-size">18</property>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label" translatable="yes">Sign Up</property>
											</object>
										</child>
									</object>
								</property>
								<style>
									<class name="pill" />
								</style>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</template>
</interface>
