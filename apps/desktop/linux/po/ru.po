#: data/com.keygenqt.ydx.metainfo.xml.in:41
msgid "Cross-platform UI"
msgstr "Кросс‑платформенный интерфейс"

#: data/com.keygenqt.ydx.metainfo.xml.in:42
msgid "Device synchronization"
msgstr "Синхронизация устройств"

#: data/com.keygenqt.ydx.metainfo.xml.in:43
msgid "Multi-language support (EN, RU, ZH)"
msgstr "Поддержка нескольких языков (EN, RU, ZH)"

