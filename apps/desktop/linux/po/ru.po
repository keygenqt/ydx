#: data/com.keygenqt.ydx.metainfo.xml.in:14
msgid "Lightning fast on any device"
msgstr "Молниеносно быстро на любом устройстве"

#: data/com.keygenqt.ydx.metainfo.xml.in:15
msgid "Synchronization between all your devices"
msgstr "Синхронизация между всеми вашими устройствами"

#: data/com.keygenqt.ydx.metainfo.xml.in:16
msgid "Available in Russian, English, and Chinese on all platforms"
