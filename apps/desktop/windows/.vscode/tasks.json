{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-winui",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/YDX/YDX.csproj",
                "/property:GenerateFullPaths=true",
                "/property:Platform=x64",
                "/property:RuntimeIdentifier=win-x64",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}