<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YDX.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Command="{x:Bind ViewModel.GoBackCommand}"
                BorderThickness="0"
                Width="46"
                Height="31"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}">

                <Button.Resources>
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.01"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.2"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.1"/>
                </Button.Resources>

                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
            </Button>

            <Grid x:Name="AppTitleBar" Grid.Column="1" HorizontalAlignment="Stretch">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1"/>
    </Grid>
</Window>
