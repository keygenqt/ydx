<UserControl x:Class="YDX.Views.Pages.Welcome.Elements.WelcomeAuth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YDX.Views.Pages.Welcome"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WelcomeViewModel}">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <TextBlock Text="Welcome to YDX!"
                  FontSize="36"
                  FontWeight="Bold"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,30"/>

        <ContentControl Style="{StaticResource AppIconStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

        <StackPanel Orientation="Vertical"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30">

            <TextBlock Text="✓ Native experience on all 8 platforms"
                      FontSize="14"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Center"/>

            <TextBlock Text="✓ Lightning fast on any device"
                      FontSize="14"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Center"/>

            <TextBlock Text="✓ Sync across all devices"
                      FontSize="14"
                      HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Margin="0,16">

            <Button Command="{Binding SignInCommand}"
                   Content="Sign In"
                   Padding="30,10"
                   Margin="10"
                   FontSize="16"/>

            <Button Command="{Binding SignUpCommand}"
                   Content="Sign Up"
                   Padding="30,10"
                   Margin="10"
                   FontSize="16"/>
        </StackPanel>
    </StackPanel>
</UserControl>