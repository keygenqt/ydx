<Page x:Class="YDX.Views.Pages.Welcome.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:YDX.Views.Pages.Welcome.Elements"
      xmlns:vm="clr-namespace:YDX.Views.Pages.Welcome"
      mc:Ignorable="d"
      Title="Welcome"
      d:DataContext="{d:DesignInstance vm:WelcomeViewModel}">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <local:WelcomeAuth
                Visibility="{Binding ShowAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource FadeInWhenTrue}"
                Tag="{Binding ShowAuth}"/>

            <local:WelcomeLoading
                Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource FadeInWhenTrue}"
                Tag="{Binding ShowLoading}"/>

        </StackPanel>
    </Grid>
</Page>