<Page x:Class="YDX.Views.Pages.Welcome.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:strings="using:YDX.Strings">

    <StackPanel HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Spacing="36">

        <TextBlock Text="{x:Bind strings:Resources.WelcomeTitle}"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <Image Style="{StaticResource IconLogoSvg}"
               HorizontalAlignment="Center"/>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind strings:Resources.Feature1}"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind strings:Resources.Feature2}"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind strings:Resources.Feature3}"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Spacing="20">

            <Button Command="{x:Bind ViewModel.ToSignInCommand}"
                    Content="{x:Bind strings:Resources.SignIn}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="30,10"
                    MinWidth="120"/>

            <Button Command="{x:Bind ViewModel.ToSignUpCommand}"
                    Content="{x:Bind strings:Resources.SignUp}"
                    Padding="30,10"
                    MinWidth="120"/>
        </StackPanel>
    </StackPanel>
</Page>
