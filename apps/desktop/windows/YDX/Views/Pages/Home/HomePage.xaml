<Page x:Class="YDX.Views.Pages.Home.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:YDX.Models"
      xmlns:strings="using:YDX.Strings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefault}"
              Height="48">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- About -->
            <Button Grid.Column="0"
                    ToolTipService.ToolTip="{x:Bind strings:Resources.About}"
                    Command="{x:Bind ViewModel.ShowAboutCommand}"
                    Background="Transparent"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE946;" 
                          FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                          FontSize="16"/>
            </Button>

            <!-- Logout -->
            <Button Grid.Column="2"
                    ToolTipService.ToolTip="{x:Bind strings:Resources.Logout}"
                    Command="{x:Bind ViewModel.LogoutCommand}"
                    Background="Transparent"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right">
                <FontIcon Glyph="&#xF3B1;" 
                          FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                          FontSize="16"/>
            </Button>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24"
                        Margin="20">

                <TextBlock Text="{x:Bind strings:Resources.WelcomeTitle}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{x:Bind ViewModel.DataLabel, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="400"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Command="{x:Bind ViewModel.FetchDataCommand}"
                        Content="{x:Bind strings:Resources.FetchData}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="24,12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
