<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="images\**" />
    <EmbeddedResource Remove="images\**" />
    <None Remove="images\**" />
    <Page Remove="images\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Images\svg\ydx.svg" />
    <None Remove="Native\shared.dll" />
    <None Remove="Native\ydx_windows.dll" />
    <None Remove="windows.svg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\svg\ydx.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Content Include="Native\ydx_windows.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="BeforeBuild">
    <Exec Command="call &quot;$(MSBuildProjectDirectory)\..\..\..\..\core\scripts\windows\build.bat&quot;" />
  </Target>
</Project>
