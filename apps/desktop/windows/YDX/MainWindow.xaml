<Window x:Class="YDX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YDX"
        mc:Ignorable="d"
        Title="YDX" Height="450" Width="800">
    <Grid>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
            <TextBlock
                Text="YDX"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
            />
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
            >
                <Image
                    Margin="10"
                    Source="images/windows.png"
                    Width="100"
                    Height="100"
                />
                <Image
                    Margin="10"
                    Source="images/rust.png"
                    Width="100"
                    Height="100"
                />
            </StackPanel>
            <Button
                x:Name="RunTestButton"
                Content="Run performance test"
                HorizontalAlignment="Center"
                Padding="20,10"
                Margin="0,10"
                FontSize="14"
                Click="RunTestButton_Click"
            />
            <TextBlock
                Text="Click to test the performance of the Rust C library."
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="400"
                Margin="0,10"
                Foreground="Gray"
                FontSize="12"
            />
        </StackPanel>
    </Grid>
</Window>
